# โดเมนที่ชี้ (A record) มาที่ IP บ้าน เช่น screen.example.com (ถ้าใช้ prefix path ใส่แค่โดเมน ไม่ต้องมี /tesla)
DOMAIN=

# token ที่ Mac ใช้ส่งภาพและ input agent (สร้างด้วย: openssl rand -hex 24)
PUBLISH_TOKEN=

# PIN ที่พิมพ์บน Tesla เพื่อควบคุม Mac (อย่างน้อย 6 ตัว ยิ่งยาวยิ่งดี)
CONTROL_PIN=

# (ไม่บังคับ) เมื่อใช้ compose.behind-proxy.yml: พอร์ต HTTP ที่ nginx/reverse proxy จะส่งต่อมา (ค่าเริ่มต้น 8088)
# PROXY_PORT=8088
